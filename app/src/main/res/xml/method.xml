<?xml version="1.0" encoding="utf-8"?>
<!--
  No subtypes are declared on purpose. English/Bangla are switched internally with
  the globe key, so the system shows the keyboard simply as "Amader Bangla Keyboard"
  in the keyboard picker (no language line) — matching how Samsung/Ridmik appear.
  (A third-party IME can't show per-language subtext in Settings without also adding
  a language line to the picker, so we keep the picker clean.)
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.amerganim.banglakeyboard.SetupActivity" />
