<?xml version="1.0" encoding="utf-8"?>
<!--
  English/Bangla are switched internally with the globe key. We declare a primary
  subtype labelled with the keyboard name (so the picker's main line reads "Amader
  Bangla Keyboard" instead of a bare language name) and an English subtype so the
  system settings list shows that English is supported too.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.amerganim.banglakeyboard.SetupActivity">

    <subtype
        android:label="@string/ime_label"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeLocale="bn_BD"
        android:isAsciiCapable="true" />

    <subtype
        android:label="@string/subtype_english"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeLocale="en_US"
        android:isAsciiCapable="true" />

</input-method>
