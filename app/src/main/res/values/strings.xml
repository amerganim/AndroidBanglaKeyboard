    <!-- Setup screen -->
    <string name="setup_title">Amader Bangla Keyboard</string>
    <string name="setup_subtitle">Phonetic Bangla typing — type \"amar\" to get আমার.</string>
    <string name="language">Language</string>
    <string name="getting_started">Getting started</string>
    <string name="gs_1">1. Enable the keyboard in system settings.</string>
    <string name="gs_2">2. Switch to it with the keyboard picker.</string>
    <string name="gs_3">3. Tap the 🌐 globe key to switch English ⇄ Bangla.</string>
    <string name="gs_4">4. Tap ⇧ once for one capital (T → ট); it releases after one key.</string>
    <string name="security_note">Note: Android will warn that this keyboard \"may collect what you type.\" That is the standard message Android shows for every keyboard (even Gboard) — it is about what keyboards can technically do. Amader Bangla Keyboard has no internet permission, so it cannot send anything anywhere; everything stays on your device.</string>
