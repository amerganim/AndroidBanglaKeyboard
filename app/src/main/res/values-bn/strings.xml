    <!-- Setup screen -->
    <string name="setup_title">আমাদের বাংলা কিবোর্ড</string>
    <string name="setup_subtitle">ফোনেটিক বাংলা টাইপিং — \"amar\" লিখলে হয় আমার।</string>
    <string name="language">ভাষা</string>
    <string name="getting_started">শুরু করুন</string>
    <string name="gs_1">১. সিস্টেম সেটিংসে কিবোর্ডটি চালু করুন।</string>
    <string name="gs_2">২. কিবোর্ড পিকার থেকে এটি নির্বাচন করুন।</string>
    <string name="gs_3">৩. English ⇄ বাংলা বদলাতে 🌐 গ্লোব কী চাপুন।</string>
    <string name="gs_4">৪. একটি বড় হাতের অক্ষরের জন্য ⇧ একবার চাপুন (T → ট); একটি কী-র পরেই তা ছেড়ে যায়।</string>
    <string name="security_note">দ্রষ্টব্য: Android সতর্ক করবে যে এই কিবোর্ড আপনার লেখা \"সংগ্রহ করতে পারে\"। এটি প্রতিটি কিবোর্ডের (এমনকি Gboard-এর) জন্য Android-এর স্ট্যান্ডার্ড বার্তা — কিবোর্ড কারিগরিভাবে কী করতে পারে সে সম্পর্কে। আমাদের বাংলা কিবোর্ডের কোনো ইন্টারনেট অনুমতি নেই, তাই এটি কিছুই কোথাও পাঠাতে পারে না; সবকিছু আপনার ডিভাইসেই থাকে।</string>
